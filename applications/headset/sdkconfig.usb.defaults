# Headset variant: the real `usound` image, with the USB device stack started.
#
# This is what the product ships. It is a separate variant only because flashing it
# severs the USB-Serial/JTAG console (see CONFIG_HEADSET_ENABLE_USB's help), so the
# default build leaves it off and CI builds this one without ever flashing it.
#
# Applied on top of sdkconfig.defaults. SDKCONFIG must be given too, or this variant
# rewrites the default build's configuration and the two silently share one:
#
#   idf.py -C applications/headset -B build_usb -D SDKCONFIG=sdkconfig.usb \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.usb.defaults" build
#
# Recovering the board afterwards means holding BOOT while replugging to reach ROM
# download mode — replugging alone will not do it, because this image re-takes the
# PHY about a second after every boot.
CONFIG_HEADSET_ENABLE_USB=y
