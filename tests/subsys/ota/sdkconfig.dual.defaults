# Alternative defaults for the ota test: 16 MiB dual-slot layout, so ota_init()
# succeeds and the session state machine can be exercised.
#   idf.py -B build_dual -D SDKCONFIG_DEFAULTS="../../sdkconfig.common.defaults;sdkconfig.dual.defaults" build
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_WIFI_ENABLED=y
